<?xml version="1.0"?>
<robot name="car_mecanum" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_camera" default="true"/>

  <xacro:include filename="$(find car_description)/urdf/mecanum_properties.xacro" />
  <xacro:include filename="$(find car_description)/urdf/mech/base.xacro" />
  <xacro:include filename="$(find car_description)/urdf/mech/mecanum_wheel.xacro" />
  <xacro:include filename="$(find car_description)/urdf/sensors/imu.xacro" />
  <xacro:include filename="$(find car_description)/urdf/sensors/generic_laser.xacro" />
  <xacro:include filename="$(find car_description)/urdf/sensors/depth_sensor.xacro" />
  
  <xacro:base 
    length="${base_length}" 
    width="${base_width}" 
    height="${base_height}" 
    mass="${base_mass}"
    wheel_radius="${wheel_radius}"
    wheel_pos_z="${wheel_pos_z}"
  />

  <xacro:mecanum_wheel 
    side="front_left"
    radius="${wheel_radius}" 
    width="${wheel_width}" 
    pos_x="${wheel_pos_x}" 
    pos_y="${wheel_pos_y}" 
    pos_z="${wheel_pos_z}" 
    mass="${wheel_mass}"
  />

  <xacro:mecanum_wheel 
    side="front_right"
    radius="${wheel_radius}" 
    width="${wheel_width}" 
    pos_x="${wheel_pos_x}" 
    pos_y="${-wheel_pos_y}" 
    pos_z="${wheel_pos_z}" 
    mass="${wheel_mass}"
  />
  <xacro:mecanum_wheel 
    side="rear_left"
    radius="${wheel_radius}" 
    width="${wheel_width}" 
    pos_x="${-wheel_pos_x}" 
    pos_y="${wheel_pos_y}" 
    pos_z="${wheel_pos_z}" 
    mass="${wheel_mass}"
  />

  <xacro:mecanum_wheel 
    side="rear_right"
    radius="${wheel_radius}" 
    width="${wheel_width}" 
    pos_x="${-wheel_pos_x}" 
    pos_y="${-wheel_pos_y}" 
    pos_z="${wheel_pos_z}" 
    mass="${wheel_mass}"
  />

  <xacro:imu/>
  
  <xacro:generic_laser>
    <xacro:insert_block name="laser_pose" />
  </xacro:generic_laser>

  <xacro:depth_sensor use_camera="$(arg use_camera)">
    <xacro:insert_block name="depth_sensor_pose" />
  </xacro:depth_sensor>
  
  <xacro:include filename="$(find car_description)/urdf/controllers/car_ros2_control.xacro" />  
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find car_bringup)/config/car_controller.yaml</parameters>  
    </plugin>
  </gazebo>
</robot>