<mujoco model="mecanum_car">
    <!-- Units: m, kg, s, rad. +X forward, +Y left, +Z up.
         User chassis: 0.30 x 0.20 x 0.03 m, 6 kg; centre coincides with base_link.
         Measured wheels: diameter 0.05 m, width 0.03 m, wheelbase 0.20 m, track 0.25 m.
         Wheel centres are 0.010 m below base_link; nominal chassis clearance is 0.020 m.
         Each complete wheel is 0.120 kg: 0.108 kg hub assembly + 12 rollers of 0.001 kg.
         base_link is the floating root; wheels mount directly to its sides on short axles. -->
    <compiler angle="radian" autolimits="true" meshdir="assets/meshs" />
    <option timestep="0.001" integrator="implicitfast" solver="Newton" iterations="100" tolerance="1e-9" gravity="0 0 -9.81" />
    <statistic center="0 0 0.035" extent="0.5" />
    <visual>
        <global linewidth="0.2" />
        <headlight ambient="0.3 0.3 0.3" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" />
        <rgba rangefinder="0.1 0.65 0.5 0.22" />
    </visual>
    <custom>
        <numeric name="wheel_radius" data="0.025" />
        <numeric name="lidar_min_range" data="0.05" />
    </custom>
    <default>
        <joint type="hinge" limited="false" />
        <geom contype="1" conaffinity="0" condim="3" friction="1.0 0.005 0.0001" solref="0.005 1" solimp="0.95 0.99 0.001" />
        <default class="wheel_joint">
            <joint axis="0 1 0" damping="0.001" armature="0.00001" />
        </default>
        <default class="roller_joint">
            <joint damping="0.00001" armature="0.0000001" />
        </default>
        <default class="visual">
            <geom contype="0" conaffinity="0" group="2" mass="0" />
        </default>
        <default class="collision">
            <geom group="3" rgba="0.25 0.25 0.25 0.35" />
        </default>
    </default>
    <asset>
        <texture name="sky" type="skybox" builtin="gradient" rgb1="0.82 0.85 0.88" rgb2="0.96 0.97 0.98" width="512" height="512" />
        <texture name="floor_checker" type="2d" builtin="checker" rgb1="0.58 0.60 0.62" rgb2="0.50 0.52 0.54" width="512" height="512" />
        <material name="floor_material" texture="floor_checker" texuniform="true" texrepeat="5 5" reflectance="0" specular="0.03" shininess="0.1" />
        <mesh name="wheel_1" file="wheel_1.stl" scale="0.196850394 0.303030303 0.196850394" />
        <mesh name="wheel_2" file="wheel_2.stl" scale="0.196850394 0.303030303 0.196850394" />
    </asset>
