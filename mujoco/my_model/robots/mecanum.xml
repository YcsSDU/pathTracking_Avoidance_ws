        <geom name="floor" type="plane" pos="0 0 0" size="20 20 0.1" material="floor_material" contype="1" conaffinity="1" />
        
        <geom name="lidar_wall_front" type="box" pos="1.2 0 0.15" size="0.025 1.225 0.15" rgba="0.52 0.60 0.65 1" contype="1" conaffinity="1" />
