    <!-- Actuator/speed array order: FL, FR, BL, BR. Inputs are wheel torque in N m.
        X-layout: front-left/back-right roller axes have opposite hand to the other pair. 
        执行器/速度阵列顺序：前左、前右、后左、后右。输入为轮子扭矩（N·m）。  
        X轴布局：前左/后右滚轮轴的手柄方向与另一对相反。-->
    <actuator>
        <motor name="front_left_motor" joint="front_left_wheel_rolling_joint" ctrllimited="true" ctrlrange="-0.25 0.25" />
        <motor name="front_right_motor" joint="front_right_wheel_rolling_joint" ctrllimited="true" ctrlrange="-0.25 0.25" />
        <motor name="back_left_motor" joint="back_left_wheel_rolling_joint" ctrllimited="true" ctrlrange="-0.25 0.25" />
        <motor name="back_right_motor" joint="back_right_wheel_rolling_joint" ctrllimited="true" ctrlrange="-0.25 0.25" />
    </actuator>
    <sensor>
        <jointvel name="front_left_wheel_speed" joint="front_left_wheel_rolling_joint" />
        <jointvel name="front_right_wheel_speed" joint="front_right_wheel_rolling_joint" />
        <jointvel name="back_left_wheel_speed" joint="back_left_wheel_rolling_joint" />
        <jointvel name="back_right_wheel_speed" joint="back_right_wheel_rolling_joint" />
        <framepos name="base_position" objtype="body" objname="base_link" />
        <framequat name="base_orientation" objtype="body" objname="base_link" />
        <velocimeter name="base_linear_velocity" site="base_imu" />
        <gyro name="base_angular_velocity" site="base_imu" />
        <accelerometer name="base_acceleration" site="base_imu" />
        <rangefinder name="lidar_range" site="lidar_ray" cutoff="8" nsample="2" interval="0.1" />
    </sensor>
</mujoco>
